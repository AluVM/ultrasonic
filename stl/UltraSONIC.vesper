@@lexicon(types+commitments)


-- Contract Codex

commitment CodexId: for Codex, hasher SHA256, tagged urn:ubideco:sonic:codex#2025-05-15 
  serialize Codex

struct Codex
  bytes version: len 1, alias ReservedBytes1 
  str name: len 0..=FF.h 
  ascii developer: alias Identity, first AsciiPrintable, rest AsciiPrintable, len 1..=1000.h 
  field timestamp: I64 
  bytes features: len 4, alias ReservedBytes4 
  field fieldOrder: U256 
  struct verificationConfig: CoreConfig 
    enum halt: Bool, false 0, true 1 
      field some: U64, option, wrapped, tag 1 
  struct inputConfig: CoreConfig 
    enum halt: Bool, false 0, true 1 
      field some: U64, option, wrapped, tag 1 
  map verifiers: len 0..=FF.h 
    field key: U16 
    struct value: LibSite 
      bytes libId: len 32, alias LibId 
      field offset: U16 


-- Contract Issue

commitment ContractId: for Issue, hasher SHA256, tagged urn:ubideco:sonic:contract#2024-11-16 
  serialize ReservedBytes1
  serialize ContractMeta
  serialize CodexId
  serialize Opid

struct Issue
  bytes version: len 1, alias ReservedBytes1 
  struct meta: ContractMeta 
    enum testnet: Bool, false 0, true 1 
    enum consensus: Consensus, none 0, bitcoin 16, liquid 17, prime 32 
    field timestamp: I64 
    bytes features: len 6, alias ReservedBytes6 
    union name: ContractName 
      field unnamed: Unit, tag 0 
      ascii named: wrapped, alias TypeName, first AlphaCapsLodash, rest AlphaNumLodash, len 1..=64.h, tag 1 
    ascii issuer: alias Identity, first AsciiPrintable, rest AsciiPrintable, len 1..=1000.h 
  struct codex: Codex 
    bytes version: len 1, alias ReservedBytes1 
    str name: len 0..=FF.h 
    ascii developer: alias Identity, first AsciiPrintable, rest AsciiPrintable, len 1..=1000.h 
    field timestamp: I64 
    bytes features: len 4, alias ReservedBytes4 
    field fieldOrder: U256 
    struct verificationConfig: CoreConfig 
      enum halt: Bool, false 0, true 1 
        field some: U64, option, wrapped, tag 1 
    struct inputConfig: CoreConfig 
      enum halt: Bool, false 0, true 1 
        field some: U64, option, wrapped, tag 1 
    map verifiers: len 0..=FF.h 
      field key: U16 
      struct value: LibSite 
        bytes libId: len 32, alias LibId 
        field offset: U16 
  struct genesis: Genesis 
    bytes version: len 1, alias ReservedBytes1 
    bytes codexId: len 32, alias CodexId 
    field callId: U16 
    field nonce: U256, alias Fe256 
    bytes blank0: len 1, alias ReservedBytes1 
    bytes blank1: len 2, alias ReservedBytes2 
    bytes blank2: len 2, alias ReservedBytes2 
    list destructibleOut: len 0..<2^16 
      struct StateCell
        union data: StateValue 
          field none: Unit, tag 0 
          struct single: tag 1 
            field first: U256, alias Fe256 
          struct double: tag 2 
            field first: U256, alias Fe256 
            field second: U256, alias Fe256 
          struct triple: tag 3 
            field first: U256, alias Fe256 
            field second: U256, alias Fe256 
            field third: U256, alias Fe256 
          struct quadruple: tag 4 
            field first: U256, alias Fe256 
            field second: U256, alias Fe256 
            field third: U256, alias Fe256 
            field fourth: U256, alias Fe256 
        field auth: U256, alias AuthToken, alias Fe256 
          struct some: CellLock, option, wrapped, tag 1 
            union aux: StateValue 
              field none: Unit, tag 0 
              struct single: tag 1 
                field first: U256, alias Fe256 
              struct double: tag 2 
                field first: U256, alias Fe256 
                field second: U256, alias Fe256 
              struct triple: tag 3 
                field first: U256, alias Fe256 
                field second: U256, alias Fe256 
                field third: U256, alias Fe256 
              struct quadruple: tag 4 
                field first: U256, alias Fe256 
                field second: U256, alias Fe256 
                field third: U256, alias Fe256 
                field fourth: U256, alias Fe256 
              struct some: LibSite, option, wrapped, tag 1 
                bytes libId: len 32, alias LibId 
                field offset: U16 
    list immutableOut: len 0..<2^16 
      struct StateData
        union value: StateValue 
          field none: Unit, tag 0 
          struct single: tag 1 
            field first: U256, alias Fe256 
          struct double: tag 2 
            field first: U256, alias Fe256 
            field second: U256, alias Fe256 
          struct triple: tag 3 
            field first: U256, alias Fe256 
            field second: U256, alias Fe256 
            field third: U256, alias Fe256 
          struct quadruple: tag 4 
            field first: U256, alias Fe256 
            field second: U256, alias Fe256 
            field third: U256, alias Fe256 
            field fourth: U256, alias Fe256 
          bytes some: len 0..<2^16, option, wrapped, alias RawData, tag 1 


-- Contract Genesis

commitment Opid: for Operation, hasher SHA256, tagged urn:ubideco:ultrasonic:operation#2024-11-14 
  serialize ReservedBytes1
  serialize ContractId
  serialize U16
  serialize Fe256
  serialize StateValue
  merklize Input
    serialize Input
  merklize CellAddr
    serialize CellAddr
  merklize StateCell
    serialize StateCell
  merklize StateData
    serialize StateData

struct Genesis
  bytes version: len 1, alias ReservedBytes1 
  bytes codexId: len 32, alias CodexId 
  field callId: U16 
  field nonce: U256, alias Fe256 
  bytes blank0: len 1, alias ReservedBytes1 
  bytes blank1: len 2, alias ReservedBytes2 
  bytes blank2: len 2, alias ReservedBytes2 
  list destructibleOut: len 0..<2^16 
    struct StateCell
      union data: StateValue 
        field none: Unit, tag 0 
        struct single: tag 1 
          field first: U256, alias Fe256 
        struct double: tag 2 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
        struct triple: tag 3 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
        struct quadruple: tag 4 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
          field fourth: U256, alias Fe256 
      field auth: U256, alias AuthToken, alias Fe256 
        struct some: CellLock, option, wrapped, tag 1 
          union aux: StateValue 
            field none: Unit, tag 0 
            struct single: tag 1 
              field first: U256, alias Fe256 
            struct double: tag 2 
              field first: U256, alias Fe256 
              field second: U256, alias Fe256 
            struct triple: tag 3 
              field first: U256, alias Fe256 
              field second: U256, alias Fe256 
              field third: U256, alias Fe256 
            struct quadruple: tag 4 
              field first: U256, alias Fe256 
              field second: U256, alias Fe256 
              field third: U256, alias Fe256 
              field fourth: U256, alias Fe256 
            struct some: LibSite, option, wrapped, tag 1 
              bytes libId: len 32, alias LibId 
              field offset: U16 
  list immutableOut: len 0..<2^16 
    struct StateData
      union value: StateValue 
        field none: Unit, tag 0 
        struct single: tag 1 
          field first: U256, alias Fe256 
        struct double: tag 2 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
        struct triple: tag 3 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
        struct quadruple: tag 4 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
          field fourth: U256, alias Fe256 
        bytes some: len 0..<2^16, option, wrapped, alias RawData, tag 1 


-- Contract Operation

commitment Opid: for Operation, hasher SHA256, tagged urn:ubideco:ultrasonic:operation#2024-11-14 
  serialize ReservedBytes1
  serialize ContractId
  serialize U16
  serialize Fe256
  serialize StateValue
  merklize Input
    serialize Input
  merklize CellAddr
    serialize CellAddr
  merklize StateCell
    serialize StateCell
  merklize StateData
    serialize StateData

struct Operation
  bytes version: len 1, alias ReservedBytes1 
  bytes contractId: len 32, alias ContractId 
  field callId: U16 
  field nonce: U256, alias Fe256 
  union witness: StateValue 
    field none: Unit, tag 0 
    struct single: tag 1 
      field first: U256, alias Fe256 
    struct double: tag 2 
      field first: U256, alias Fe256 
      field second: U256, alias Fe256 
    struct triple: tag 3 
      field first: U256, alias Fe256 
      field second: U256, alias Fe256 
      field third: U256, alias Fe256 
    struct quadruple: tag 4 
      field first: U256, alias Fe256 
      field second: U256, alias Fe256 
      field third: U256, alias Fe256 
      field fourth: U256, alias Fe256 
  list destructibleIn: len 0..<2^16 
    struct Input
      struct addr: CellAddr 
        bytes opid: len 32, alias Opid 
        field pos: U16 
      union witness: StateValue 
        field none: Unit, tag 0 
        struct single: tag 1 
          field first: U256, alias Fe256 
        struct double: tag 2 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
        struct triple: tag 3 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
        struct quadruple: tag 4 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
          field fourth: U256, alias Fe256 
  list immutableIn: len 0..<2^16 
    struct CellAddr
      bytes opid: len 32, alias Opid 
      field pos: U16 
  list destructibleOut: len 0..<2^16 
    struct StateCell
      union data: StateValue 
        field none: Unit, tag 0 
        struct single: tag 1 
          field first: U256, alias Fe256 
        struct double: tag 2 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
        struct triple: tag 3 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
        struct quadruple: tag 4 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
          field fourth: U256, alias Fe256 
      field auth: U256, alias AuthToken, alias Fe256 
        struct some: CellLock, option, wrapped, tag 1 
          union aux: StateValue 
            field none: Unit, tag 0 
            struct single: tag 1 
              field first: U256, alias Fe256 
            struct double: tag 2 
              field first: U256, alias Fe256 
              field second: U256, alias Fe256 
            struct triple: tag 3 
              field first: U256, alias Fe256 
              field second: U256, alias Fe256 
              field third: U256, alias Fe256 
            struct quadruple: tag 4 
              field first: U256, alias Fe256 
              field second: U256, alias Fe256 
              field third: U256, alias Fe256 
              field fourth: U256, alias Fe256 
            struct some: LibSite, option, wrapped, tag 1 
              bytes libId: len 32, alias LibId 
              field offset: U16 
  list immutableOut: len 0..<2^16 
    struct StateData
      union value: StateValue 
        field none: Unit, tag 0 
        struct single: tag 1 
          field first: U256, alias Fe256 
        struct double: tag 2 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
        struct triple: tag 3 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
        struct quadruple: tag 4 
          field first: U256, alias Fe256 
          field second: U256, alias Fe256 
          field third: U256, alias Fe256 
          field fourth: U256, alias Fe256 
        bytes some: len 0..<2^16, option, wrapped, alias RawData, tag 1 

